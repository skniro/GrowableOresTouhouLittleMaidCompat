{
  "schemaVersion": 1,
  "id": "growable_ores_snad_compat",
  "version": "${version}",
  "name": "Skniro's GrowableOres Snad Compat",
  "description": "Add some growable ores extension.",
  "authors": [
    "skniro"
  ],
  "contact": {
    "website": "https://www.curseforge.com/skniro"},
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.skniro.growable_ores_snad_compat.datagen.GrowableOresDataGeneration"
    ],
    "client": [
      "com.skniro.growable_ores_snad_compat.client.GrowableOresClient"
    ],
    "main": [
      "com.skniro.growable_ores_snad_compat.GrowableOresExtension"
    ]
  },
  "mixins": [
    "growable_ores_snad_compat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "fabric": "*",
    "minecraft": "1.21.x",
    "growable_ores": "*"
  }
}
